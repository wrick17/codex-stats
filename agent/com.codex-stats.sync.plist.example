<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.codex-stats.sync</string>
  <key>ProgramArguments</key>
  <array><string>/opt/homebrew/bin/bun</string><string>REPLACE_WITH_REPO_PATH/agent/collector.js</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CODEX_STATS_URL</key><string>https://codex-stats.pages.dev</string>
    <key>CODEX_STATS_SYSTEM</key><string>REPLACE_WITH_SYSTEM_NAME</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/codex-stats.log</string>
  <key>StandardErrorPath</key><string>/tmp/codex-stats.log</string>
</dict>
</plist>
